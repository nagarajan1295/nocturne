#!/bin/sh
set -eu

# BirdThing: point at the Pi dashboard. Prefer the Bluetooth-PAN link
# (192.168.44.1), fall back to USB (192.168.7.1). A full NOCTURNE_CHROMIUM_URL
# still wins outright; BIRD_PI_HOSTS overrides the candidate list.
CHROME="${NOCTURNE_CHROME_BIN:-/usr/bin/chromium-browser/chrome}"
PORT=8090
HOSTS="${BIRD_PI_HOSTS:-192.168.44.1 192.168.7.1}"

APP_URL=""
attempt=0
while [ -z "$APP_URL" ]; do
  # An explicit full URL trumps host probing.
  if [ -n "${NOCTURNE_CHROMIUM_URL:-}" ] && wget -q -T 2 -O /dev/null "$NOCTURNE_CHROMIUM_URL"; then
    APP_URL="$NOCTURNE_CHROMIUM_URL"
    break
  fi
  for h in $HOSTS; do
    if wget -q -T 2 -O /dev/null "http://${h}:${PORT}/"; then
      APP_URL="http://${h}:${PORT}/"
      break
    fi
  done
  [ -n "$APP_URL" ] && break
  attempt=$((attempt + 1))
  if [ "$attempt" -eq 1 ] || [ $((attempt % 5)) -eq 0 ]; then
    echo "start-chromium: waiting for the Pi dashboard on [$HOSTS]:$PORT (attempt $attempt)"
  fi
  sleep 1
done

echo "start-chromium: dashboard reachable; launching Chromium at $APP_URL"

# Flags mirror the working USB BirdThing (Debian kiosk) launcher: GPU OFF
# (--disable-gpu) to stop the flicker the weston transform=90 rotation causes
# with HW compositing; --force-device-scale-factor=1 so the 800x480 dashboard
# isn't crunched/misscaled; --disable-smooth-scrolling so knob (Arrow-key)
# scrolling isn't laggy. Panel is 800x480 after rotation, scale 1.0.
exec "$CHROME" \
  --no-sandbox \
  --disable-gpu \
  --force-device-scale-factor=1 \
  --window-size=800,480 \
  --window-position=0,0 \
  --remote-debugging-port=2222 \
  --user-data-dir=/var/lib/chrome_storage \
  --kiosk \
  --disable-smooth-scrolling \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --hide-scrollbars \
  --disable-overlay-scrollbar \
  --disable-features=OverlayScrollbar,TranslateUI \
  --disable-login-animations \
  --disable-modal-animations \
  --noerrdialogs \
  --no-first-run \
  --disable-infobars \
  --disable-translate \
  --autoplay-policy=no-user-gesture-required \
  --allow-file-access-from-files \
  --ignore-certificate-errors \
  --enable-experimental-web-platform-features \
  --app="$APP_URL"
