#!/bin/sh
set -eu

# BirdThing: point at the Pi dashboard. Prefer the Bluetooth-PAN link
# (192.168.44.1), fall back to USB (192.168.7.1). A full NOCTURNE_CHROMIUM_URL
# still wins outright; BIRD_PI_HOSTS overrides the candidate list.
CHROME="${NOCTURNE_CHROME_BIN:-/usr/bin/chromium-browser/chrome}"
PORT=8090
HOSTS="${BIRD_PI_HOSTS:-192.168.44.1 192.168.7.1}"

APP_URL=""
attempt=0
while [ -z "$APP_URL" ]; do
  # An explicit full URL trumps host probing.
  if [ -n "${NOCTURNE_CHROMIUM_URL:-}" ] && wget -q -T 2 -O /dev/null "$NOCTURNE_CHROMIUM_URL"; then
    APP_URL="$NOCTURNE_CHROMIUM_URL"
    break
  fi
  for h in $HOSTS; do
    if wget -q -T 2 -O /dev/null "http://${h}:${PORT}/"; then
      APP_URL="http://${h}:${PORT}/"
      break
    fi
  done
  [ -n "$APP_URL" ] && break
  attempt=$((attempt + 1))
  if [ "$attempt" -eq 1 ] || [ $((attempt % 5)) -eq 0 ]; then
    echo "start-chromium: waiting for the Pi dashboard on [$HOSTS]:$PORT (attempt $attempt)"
  fi
  sleep 1
done

echo "start-chromium: dashboard reachable; launching Chromium at $APP_URL"

exec "$CHROME" \
  --no-sandbox \
  --in-process-gpu \
  --remote-debugging-port=2222 \
  --user-data-dir=/var/lib/chrome_storage \
  --kiosk \
  --disable-pinch \
  --allow-file-access-from-files \
  --ignore-certificate-errors \
  --enable-experimental-web-platform-features \
  --app="$APP_URL"
